{
    "manifest_version": 3,
    "name": "Remember This",
    "description": "Save notes, photos, documents and voice notes to Remember This from any page.",
    "version": "0.1.0",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Remember this",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "permissions": ["storage", "clipboardRead", "activeTab", "scripting", "contextMenus"],
    "host_permissions": ["__SITE_PATTERN__"],
    "web_accessible_resources": [
        {
            "resources": ["callback.html"],
            "matches": ["__SITE_PATTERN__"]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "browser-extension@remember-this.io",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["personallyIdentifyingInfo"]
            }
        },
        "safari": {
            "strict_min_version": "16.4"
        }
    }
}
